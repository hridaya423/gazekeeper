---
import SiteShell from "../layouts/SiteShell.astro";
import Faq from "../components/common/Faq.astro";
import CtaBand from "../components/common/CtaBand.astro";
import { MACOS_REQUIREMENT } from "../utils/site";

const chart = [
  { text: "Gaze", acuity: "20/200" },
  { text: "Keeper", acuity: "20/100" },
  { text: "Rest your", acuity: "20/70" },
  { text: "Eyes before", acuity: "20/50" },
  { text: "They ask you to", acuity: "20/30" },
  { text: "A break reminder that waits for the right moment", acuity: "20/20" },
];

const findings = [
  {
    figure: "-50%",
    claim: "You blink about half as often while you look at a screen.",
    detail:
      "Fewer blinks leave the tear film thinner and the surface of the eye drier. That is most of what “screen-tired eyes” feels like.",
    source: "American Academy of Ophthalmology",
    href: "https://www.aao.org/newsroom/news-releases/detail/protect-your-eyes-in-home-office",
  },
  {
    figure: "1 wk",
    claim: "Break reminders eased eye strain. The benefit faded a week after they stopped.",
    detail:
      "In a study of symptomatic laptop users, prompts to look away cut dry-eye and strain symptoms. Without the prompt, the habit didn’t hold. The reminder is the treatment.",
    source: "Talens-Estarelles et al., Contact Lens & Anterior Eye, 2023",
    href: "https://research.aston.ac.uk/en/publications/the-effects-of-breaks-on-digital-eye-strain-dry-eye-and-binocular/",
  },
  {
    figure: "10 min",
    claim: "Breaks of ten minutes or less raise energy and lower fatigue.",
    detail:
      "A meta-analysis of 22 samples found small, reliable gains in vigour and drops in fatigue. Effects on output were not significant, so we don’t promise productivity.",
    source: "Albulescu et al., PLOS ONE, 2022",
    href: "https://doi.org/10.1371/journal.pone.0272460",
  },
  {
    figure: "Pause",
    claim: "An interruption at a task boundary costs less than one mid-task.",
    detail:
      "Interruptions placed where mental workload dips led to faster resumption and less annoyance. That is why GazeKeeper waits for a lull in your typing.",
    source: "Bailey & Iqbal, ACM TOCHI, 2008",
    href: "https://interruptions.net/literature/Bailey-TOCHI08.pdf",
  },
];

const timeline = [
  {
    at: "14:00:00",
    kind: "count",
    pos: 0,
    title: "Counting starts",
    body: "The iris in the menu bar starts to empty. Nothing else appears.",
  },
  {
    at: "14:12:00",
    kind: "hold",
    pos: 0.421,
    title: "Camera turns on",
    body: "The countdown freezes with 8 minutes left. No banner, no sound.",
  },
  {
    at: "14:19:00",
    kind: "cool",
    pos: 0.667,
    title: "Call ends",
    body: "A 30-second cooldown, so nothing arrives while you close windows.",
  },
  {
    at: "14:26:30",
    kind: "heads",
    pos: 0.93,
    title: "Heads-up",
    body: "A small pill: break in 60 seconds. Take it now, snooze it, or let it come.",
  },
  {
    at: "14:27:30",
    kind: "break",
    pos: 0.965,
    title: "The break",
    body: "It waits for 2 seconds without typing (never more than 30), then 20 seconds of distance.",
  },
];

const signals = [
  { name: "Camera", reads: "Whether any app is using a camera", never: "The picture" },
  { name: "Microphone", reads: "Whether any app is capturing audio", never: "The sound" },
  { name: "Screen sharing", reads: "Whether a share or recording is running", never: "What is shared" },
  { name: "Fullscreen", reads: "Whether the front window covers 90% of a screen", never: "Window contents" },
  { name: "App rules", reads: "Which app is in front", never: "What you do in it" },
  { name: "Typing pause", reads: "Seconds since your last key or click", never: "Which keys" },
  { name: "Calendar", reads: "Start times of upcoming meetings (off by default)", never: "Anything else in the event" },
];

const dialTicks = 20;
const dialLit = 14;

const faqs = [
  {
    q: "Will it interrupt me mid-task?",
    a: "Not on a call, while sharing, or in fullscreen — those hold the break. When it does arrive, it gives you 60 seconds’ notice and waits for a pause in your typing.",
  },
  {
    q: "Can I skip or snooze?",
    a: "Yes. Snooze from the heads-up or the break itself, two snoozes per break by default. Skip appears after three seconds, so a reflex click doesn’t cancel a break you meant to take.",
  },
  {
    q: "What does it cost?",
    a: "Nothing. No account, no subscription, no upsell.",
  },
  {
    q: "What does it know about me?",
    a: "Whether the camera, microphone, or screen share is in use, which app is frontmost, and how long since your last keypress. Never what you type or say. Settings and stats stay on your Mac.",
  },
  {
    q: "Which Macs does it run on?",
    a: `${MACOS_REQUIREMENT} or later. It lives in the menu bar and uses no measurable CPU between breaks.`,
  },
];
---

<SiteShell title="GazeKeeper — eye breaks for Mac, timed around your work">
  <section class="hero page" aria-labelledby="hero-title">
    <div class="chart-card" aria-hidden="true">
      {
        chart.map((line, i) => (
          <p class="chart-line" style={`--i:${i}`}>
            <span class="mono">{i + 1}</span>
            <span class="chart">{line.text}</span>
            <span class="mono">{line.acuity}</span>
          </p>
        ))
      }
    </div>

    <div class="hero-copy">
      <figure class="menubar">
        <div class="menubar-strip" role="img" aria-label="The GazeKeeper menu-bar item: an iris, 14 minutes left.">
          <span class="menubar-item">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-width="1.5"
              ></circle>
              <path
                d="M8 1.75A6.25 6.25 0 1 1 2.6 11.15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
              <circle cx="8" cy="8" r="2.1" fill="currentColor"></circle>
            </svg>
            14m
          </span>
          <span>Wed 14:06</span>
        </div>
        <figcaption class="mono">The iris empties as the next break nears. Most days, that’s all you see.</figcaption>
      </figure>

      <div class="pitch">
        <h1 id="hero-title" class="display">Eye breaks timed around your work, not on top of it.</h1>
        <p class="lede">
          Every 20 minutes, GazeKeeper asks for 20 seconds of looking into the distance. On a call, presenting, or
          mid-sentence? It holds the break and lands it at your next pause.
        </p>
        <div class="actions">
          <a class="btn" href="/download">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M16.5 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.8-1.1-2.8-4.1zM14 5.1c.7-.8 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"
              ></path></svg
            >
            Download for Mac
          </a>
          <span class="mono">Free · {MACOS_REQUIREMENT}+</span>
        </div>
      </div>
    </div>
  </section>

  <section id="evidence" class="evidence page" aria-labelledby="evidence-title">
    <header class="split-head">
      <h2 id="evidence-title" class="display">What the research says. Including the parts that don’t flatter us.</h2>
      <p class="lede">Each claim links to its source. Where the evidence is thin, we say so.</p>
    </header>

    <ol role="list" class="findings">
      {
        findings.map((f) => (
          <li class="finding">
            <span class="chart figure">{f.figure}</span>
            <div class="finding-body">
              <h3>{f.claim}</h3>
              <p>{f.detail}</p>
            </div>
            <a class="mono source" href={f.href} rel="noopener">
              {f.source} ↗
            </a>
          </li>
        ))
      }
    </ol>

    <aside class="caveat">
      <span class="mono">The thin part</span>
      <p>
        The exact numbers in “20-20-20” are a convention, not a finding. A 2023 tablet-reading study found no benefit
        from the rule. Breaks help; the ideal interval is less certain. That is why the interval and the break length
        are both yours to set. <a class="link" href="/20-20-20-rule">More on the rule</a>
      </p>
    </aside>
  </section>

  <section id="timing" class="timing" aria-labelledby="timing-title">
    <div class="page">
      <header class="timing-head">
        <h2 id="timing-title" class="display">One afternoon, minute by minute.</h2>
        <p class="lede">A call lands mid-cycle. Here is exactly what GazeKeeper does, with its default timings.</p>
      </header>

      <div class="readout" aria-hidden="true">
        <p class="dial">
          <span class="mono">Wall clock</span>
          <span class="chart clock">14:<span class="clock-m"></span></span>
        </p>
        <p class="dial">
          <span class="mono">Next break in</span>
          <span class="chart clock left"><span class="left-m"></span> min</span>
        </p>
      </div>

      <div class="track" aria-hidden="true">
        <span class="seg seg-count" style="--span:12">Counting</span>
        <span class="seg seg-hold" style="--span:7">On a call · clock frozen</span>
        <span class="seg seg-cool" style="--span:0.5"></span>
        <span class="seg seg-count" style="--span:7">Counting</span>
        <span class="seg seg-heads" style="--span:1"></span>
        <span class="seg seg-lull" style="--span:0.4"></span>
        <span class="seg seg-break" style="--span:0.6"></span>
        <span class="playhead"></span>
      </div>

      <ol role="list" class="legend">
        {
          timeline.map((t) => (
            <li data-kind={t.kind} style={`--at:${t.pos}`}>
              <span class="mono">
                <i class={`swatch seg-${t.kind}`} />
                {t.at}
              </span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="break" class="rest" aria-labelledby="break-title">
    <div class="page break-inner">
      <p class="mono break-top"><span>Eye break</span><span>2 snoozes left</span></p>
      <div class="break-center">
        <div class="tick-dial" style={`--n:${dialTicks}`} aria-hidden="true">
          {Array.from({ length: dialTicks }, (_, k) => <i class:list={{ off: k >= dialLit }} style={`--k:${k}`} />)}
          <span class="chart dial-count">{dialLit}</span>
          <span class="mono dial-unit">Seconds</span>
        </div>
        <h2 id="break-title">Find something at least six metres away.</h2>
        <p>Let your focus rest on it. Blink slowly a few times. That’s the whole break — twenty seconds.</p>
      </div>
      <button type="button" class="btn break-try" data-break-demo>Try one now</button>
    </div>
  </section>

  <section class="signals page" aria-labelledby="signals-title">
    <header class="split-head">
      <h2 id="signals-title" class="display">What it watches, and what it never does.</h2>
      <p class="lede">
        Any of these can hold a break. Each one is a switch in Settings.
        <a class="link" href="/docs/detectors">How detection works</a>
      </p>
    </header>
    <table class="signal-table">
      <thead class="mono">
        <tr><th scope="col"><span class="sr-only">Line</span></th><th scope="col">Signal</th><th scope="col">Reads</th><th scope="col">Never reads</th></tr>
      </thead>
      <tbody>
        {
          signals.map((s, i) => (
            <tr>
              <td class="mono">{i + 1}</td>
              <th scope="row">{s.name}</th>
              <td>{s.reads}</td>
              <td class="never">{s.never}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <dl class="spec" aria-label="Footprint">
      <div>
        <dt class="mono">CPU between breaks</dt>
        <dd class="chart">0.0%</dd>
        <dd>It sleeps until the next event.</dd>
      </div>
      <div>
        <dt class="mono">Accounts</dt>
        <dd class="chart">0</dd>
        <dd>Settings and history stay in a folder on your Mac.</dd>
      </div>
      <div>
        <dt class="mono">Network requests</dt>
        <dd class="chart">1</dd>
        <dd>The update check. Nothing else leaves the machine.</dd>
      </div>
    </dl>
  </section>

  <section class="faq page" aria-labelledby="faq-title">
    <h2 id="faq-title" class="title">Questions</h2>
    <Faq items={faqs} />
  </section>

  <CtaBand />
</SiteShell>

<script>
  import { mountBreakDemo } from "../scripts/break-demo";
  mountBreakDemo();
</script>

<style is:global>
  .break-demo {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 56px var(--page-pad);
    border: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background: var(--night);
    color: var(--night-ink);
    animation: demo-in 400ms var(--ease-out);
  }

  .break-demo::backdrop {
    background: var(--night);
  }

  .demo-top {
    display: flex;
    justify-content: space-between;
    width: 100%;
    color: var(--night-ink-2);
    text-transform: uppercase;
  }

  .demo-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .demo-center h2 {
    font-size: clamp(24px, 2.3vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .demo-center p {
    color: var(--night-ink-2);
  }

  .tick-dial {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    width: min(360px, 70vw);
    aspect-ratio: 1;
    margin-bottom: 24px;
  }

  .tick-dial i {
    position: absolute;
    inset: 0;
    rotate: calc(var(--k) / var(--n) * 1turn);
  }

  .tick-dial i::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: max(3px, 1.2%);
    height: 7.5%;
    translate: -50% 0;
    border-radius: 2px;
    background: var(--night-teal);
    transition: background-color 600ms ease-out;
  }

  .tick-dial i.off::before {
    background: color-mix(in oklab, var(--night-ink) 12%, transparent);
  }

  .dial-count {
    font-size: clamp(88px, 9vw, 128px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .dial-unit {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--night-ink-2);
  }

  .demo-skip {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    color: var(--night-ink-2);
    animation: demo-in 300ms var(--ease-out);
  }

  .demo-skip[hidden] {
    display: inline-flex;
    visibility: hidden;
  }

  .demo-skip:hover {
    color: var(--night-ink);
    background: color-mix(in oklab, var(--night-ink) 8%, transparent);
  }

  @keyframes demo-in {
    from {
      opacity: 0;
    }
  }
</style>

<style>
  section {
    padding-block: clamp(80px, 11vw, 160px);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: clamp(32px, 4.5vw, 64px);
    padding-block: clamp(32px, 5vw, 72px);
  }

  .chart-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(8px, 1.4vw, 18px);
    padding-right: clamp(0px, 4.5vw, 64px);
    border-right: 1px solid var(--rule);
  }

  .chart-line {
    display: grid;
    grid-template-columns: 28px 1fr 56px;
    align-items: center;
    gap: 16px;
    animation: focus-in 1100ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 140ms + 150ms);
  }

  .chart-line .chart {
    text-align: center;
    line-height: 1.05;
  }

  .chart-line .mono {
    font-size: 12px;
    color: var(--ink-4);
  }

  .chart-line .mono:last-child {
    text-align: right;
  }

  .chart-line:nth-child(1) .chart {
    font-size: clamp(64px, 10.4vw, 150px);
    letter-spacing: 0.08em;
  }

  .chart-line:nth-child(2) .chart {
    font-size: clamp(40px, 6.1vw, 88px);
    letter-spacing: 0.08em;
  }

  .chart-line:nth-child(3) .chart {
    font-size: clamp(26px, 3.75vw, 54px);
    letter-spacing: 0.1em;
  }

  .chart-line:nth-child(4) .chart {
    font-size: clamp(18px, 2.5vw, 36px);
    letter-spacing: 0.12em;
  }

  .chart-line:nth-child(5) .chart {
    font-size: clamp(14px, 1.67vw, 24px);
    letter-spacing: 0.14em;
  }

  .chart-line:nth-child(6) {
    padding-top: 14px;
    border-top: 1.5px solid var(--teal);
  }

  .chart-line:nth-child(6) .chart {
    font-size: clamp(9px, 1.05vw, 15px);
    letter-spacing: 0.16em;
  }

  .chart-line:nth-child(6) .mono {
    color: var(--teal);
  }

  @keyframes focus-in {
    from {
      opacity: 0;
      filter: blur(14px);
    }
    40% {
      opacity: 1;
    }
    to {
      filter: blur(0);
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .chart-line .chart {
        animation: defocus linear both;
        animation-timeline: scroll(root);
        animation-range: 0 600px;
      }
    }
  }

  @keyframes defocus {
    to {
      opacity: 0.2;
      filter: blur(6px);
      scale: 0.94;
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
  }

  .menubar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }

  .menubar-strip {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    width: 100%;
    padding: 8px 16px;
    border-radius: 10px;
    background: var(--wash);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .menubar-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 6px;
    background: color-mix(in oklab, var(--ink) 9%, transparent);
    font-weight: 500;
  }

  .menubar figcaption {
    font-size: 12px;
    text-align: right;
    max-width: 44ch;
  }

  .pitch {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .pitch .display {
    font-size: clamp(36px, 3.1vw, 46px);
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
  }

  .split-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px 64px;
    flex-wrap: wrap;
  }

  .split-head .display {
    max-width: 15ch;
  }

  .split-head .lede {
    max-width: 38ch;
  }

  .findings {
    margin-top: 64px;
    border-top: 1.5px solid var(--ink);
  }

  .finding {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr) 240px;
    gap: 24px 48px;
    padding-block: 40px;
    border-bottom: 1px solid var(--rule);
  }

  .figure {
    font-size: clamp(48px, 5vw, 72px);
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .finding-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 560px;
  }

  .finding h3 {
    font-size: clamp(20px, 1.7vw, 24px);
    line-height: 1.33;
    letter-spacing: -0.015em;
  }

  .finding p {
    color: var(--ink-2);
  }

  .source {
    font-size: 12px;
    line-height: 1.5;
    text-align: right;
    transition: color 150ms ease;
  }

  .source:hover {
    color: var(--ink);
  }

  .caveat {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 640px);
    gap: 16px 48px;
    margin-top: 48px;
  }

  .caveat .mono {
    font-size: 12px;
    color: var(--teal);
    text-transform: uppercase;
  }

  .caveat p {
    color: var(--ink-2);
  }

  .timing {
    background: var(--wash);
  }

  .timing-head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .track {
    position: relative;
    display: flex;
    gap: 3px;
    height: 72px;
    margin-top: 72px;
  }

  .seg {
    flex: var(--span);
    display: flex;
    align-items: center;
    padding-inline: 16px;
    overflow: hidden;
    white-space: nowrap;
    border-radius: 2px;
    font-size: 14px;
    font-weight: 500;
  }

  .seg:first-of-type {
    border-radius: 8px 2px 2px 8px;
  }

  .track .seg-break {
    border-radius: 2px 8px 8px 2px;
  }

  .seg-count {
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .seg-hold {
    background: repeating-linear-gradient(135deg, var(--rule-strong) 0 3px, transparent 3px 7px);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .seg-cool {
    background: var(--rule-strong);
  }

  .seg-heads {
    background: var(--ink);
  }

  .seg-lull {
    background: var(--ink-4);
  }

  .seg-break {
    background: var(--teal);
  }

