---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Docs from "../../layouts/Docs.astro";

export async function getStaticPaths() {
  const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: docs[i - 1], next: docs[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<"docs">;
  prev?: CollectionEntry<"docs">;
  next?: CollectionEntry<"docs">;
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
---

<Docs title={`${entry.data.title} — GazeKeeper Docs`} description={entry.data.description}>
  <header>
    <h1 class="display">{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
  </header>

  {
    sections.length > 1 && (
      <nav class="toc" aria-label="On this page">
        <p class="mono">On this page</p>
        <ol role="list">
          {sections.map((heading) => (
            <li>
              <a class="link" href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <article class="prose">
    <Content />
  </article>

  <nav class="pager" aria-label="Doc pages">
    {
      prev && (
        <a href={`/docs/${prev.id}`} rel="prev">
          <span class="mono">Previous</span>
          <strong>{prev.data.title}</strong>
        </a>
      )
    }
    {
      next && (
        <a class="next" href={`/docs/${next.id}`} rel="next">
          <span class="mono">Next</span>
          <strong>{next.data.title}</strong>
        </a>
      )
    }
  </nav>
</Docs>

<style>
  header {
    display: grid;
    gap: 20px;
    margin-bottom: 40px;
  }

  .display {
    font-size: clamp(36px, 4.4vw, 56px);
  }

  .toc {
    max-width: var(--measure);
    margin-bottom: 40px;
    padding-block: 20px;
    border-block: 1px solid var(--rule);
  }

  .toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin-top: 4px;
  }

  .toc a {
    display: inline-block;
    padding-block: 10px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: var(--measure);
    margin-top: 72px;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 4px;
    padding-block: 24px;
  }

  .pager strong {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: text-decoration-color 150ms ease;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
  }

  .pager a:hover strong {
    text-decoration-color: var(--rule-strong);
  }

  .next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 520px) {
    .pager {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
