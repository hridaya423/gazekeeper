---
import { getCollection } from "astro:content";
import Docs from "../../layouts/Docs.astro";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
---

<Docs
  title="Documentation — GazeKeeper"
  description="How GazeKeeper works: installation, setup, scheduling, detectors, stats, automations and Focus filters."
>
  <header>
    <h1 class="display">Documentation</h1>
    <p class="lede">One page for each part of the app. Start with the first three.</p>
  </header>

  <ol role="list" class="index">
    {
      docs.map((doc, i) => (
        <li>
          <a href={`/docs/${doc.id}`}>
            <span class="mono">{String(i + 1).padStart(2, "0")}</span>
            <strong>{doc.data.title}</strong>
            <span class="summary">{doc.data.description}</span>
          </a>
        </li>
      ))
    }
  </ol>
</Docs>

<style>
  header {
    display: grid;
    gap: 20px;
    margin-bottom: 48px;
  }

  .display {
    font-size: clamp(36px, 4.4vw, 56px);
  }

  .index {
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
  }

  .index li {
    border-bottom: 1px solid var(--rule);
  }

  .index a {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 8px;
    row-gap: 4px;
    padding-block: 20px;
  }

  .index strong {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .summary {
    grid-column: 2;
    color: var(--ink-2);
  }

  .index a:hover strong {
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 5px;
  }
</style>
