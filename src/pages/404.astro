---
import SiteShell from "../layouts/SiteShell.astro";

const chart = [
  { text: "404", acuity: "20/200" },
  { text: "Not found", acuity: "20/70" },
  { text: "Check the link", acuity: "20/40" },
  { text: "Or go back home", acuity: "20/20" },
];
---

<SiteShell title="Page not found — GazeKeeper" description="This page is looking away.">
  <section class="page nf">
    <div class="chart-card" aria-hidden="true">
      {
        chart.map((line, i) => (
          <p class="chart-line" style={`--i:${i}`}>
            <span class="mono">{i + 1}</span>
            <span class="chart">{line.text}</span>
            <span class="mono">{line.acuity}</span>
          </p>
        ))
      }
    </div>

    <div class="copy">
      <h1 class="title">This page is looking away.</h1>
      <p class="lede">The link may be old or mistyped.</p>
      <div class="actions">
        <a class="btn" href="/">Back home</a>
        <a class="btn btn-quiet" href="/download">Get the app</a>
      </div>
    </div>
  </section>
</SiteShell>

<style>
  .nf {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 4.5vw, 64px);
    align-items: center;
    min-height: 70vh;
    padding-block: clamp(48px, 7vw, 96px);
  }

  .chart-card {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.4vw, 18px);
    padding-right: clamp(0px, 4.5vw, 64px);
    border-right: 1px solid var(--rule);
  }

  .chart-line {
    display: grid;
    grid-template-columns: 28px 1fr 56px;
    align-items: center;
    gap: 16px;
  }

  .chart-line .chart {
    text-align: center;
    line-height: 1.05;
    letter-spacing: 0.08em;
    font-size: clamp(24px, 4vw, 56px);
  }

  .chart-line:nth-child(1) .chart {
    font-size: clamp(64px, 11vw, 160px);
  }

  .chart-line:nth-child(2) .chart {
    font-size: clamp(36px, 6vw, 88px);
  }

  .chart-line:nth-child(3) .chart {
    font-size: clamp(22px, 3.2vw, 46px);
  }

  .chart-line:nth-child(4) .chart {
    font-size: clamp(14px, 1.6vw, 22px);
  }

  .chart-line .mono {
    font-size: 12px;
    color: var(--ink-3);
  }

  .chart-line .mono:last-child {
    text-align: right;
  }

  .copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 8px;
  }

  @media (max-width: 820px) {
    .nf {
      grid-template-columns: 1fr;
    }

    .chart-card {
      padding-right: 0;
      border-right: none;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 32px;
    }
  }
</style>
