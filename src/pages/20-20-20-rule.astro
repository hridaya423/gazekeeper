---
import SiteShell from "../layouts/SiteShell.astro";
import PageHero from "../components/common/PageHero.astro";
import Section from "../components/common/Section.astro";
import CtaBand from "../components/common/CtaBand.astro";
import Faq from "../components/common/Faq.astro";

const evidence = [
  {
    claim: "The American Academy of Ophthalmology advises it.",
    detail:
      "It advises the 20-20-20 rule for people who work at screens, and notes that people blink less while looking at one.",
    source: "American Academy of Ophthalmology",
    href: "https://www.aao.org/newsroom/news-releases/detail/protect-your-eyes-in-home-office",
  },
  {
    claim: "Reminders eased symptoms. The benefit faded a week after they stopped.",
    detail:
      "In a trial with break reminders, dry-eye and eye-strain symptoms went down. A week after the reminders stopped, the benefit had faded.",
    source: "Talens-Estarelles et al., Contact Lens & Anterior Eye, 2023",
    href: "https://research.aston.ac.uk/en/publications/the-effects-of-breaks-on-digital-eye-strain-dry-eye-and-binocular/",
  },
  {
    claim: "Another study found no support for it as a way to prevent strain.",
    detail:
      "In a tablet-reading study, scheduled 20-second breaks did not change symptoms, reading speed, or accuracy. The authors concluded the numbers are not justified as a preventive.",
    source: "Johnson & Rosenfield, Optometry and Vision Science, 2023 (SUNY College of Optometry)",
  },
];

const faqs = [
  {
    q: "Where do the numbers come from?",
    a: "They are a convention, not measured thresholds, and the studies above do not agree on whether they matter. GazeKeeper uses 20 minutes and 20 seconds as its defaults, and you can change both.",
  },
  {
    q: "Does it work?",
    a: "The evidence is mixed. Reminders helped in one trial and scheduled breaks did not help in another. Taking regular breaks is low-cost advice, so it is reasonable to try. It is not a treatment. If your eyes hurt or your vision changes, see an eye-care professional.",
  },
  {
    q: "Why use a reminder at all?",
    a: "One trial found the benefit faded a week after the reminders stopped. GazeKeeper keeps the reminder running.",
  },
];
---

<SiteShell
  title="The 20-20-20 rule, with a live timer — GazeKeeper"
  description="Every 20 minutes, look at something 20 feet away for 20 seconds. Try the timer in your browser, and see what the research says about it."
>
  <PageHero
    title="20 minutes. 20 feet. 20 seconds."
    subtext="A rule of thumb for screen breaks: every 20 minutes, look at something about 20 feet away for at least 20 seconds."
  />

  <Section title="Try it here" subtext="This timer runs while this tab stays open.">
    <div class="try">
      <div class="timer" id="ttt-timer">
        <div class="dial">
          <svg viewBox="0 0 260 260" width="260" height="260" aria-hidden="true">
            <circle cx="130" cy="130" r="112" fill="none" stroke="var(--rule)" stroke-width="4"></circle>
            <circle
              id="ttt-ring-progress"
              cx="130"
              cy="130"
              r="112"
              fill="none"
              stroke="var(--teal)"
              stroke-width="4"
              stroke-linecap="round"
              stroke-dasharray="703.7"
              stroke-dashoffset="703.7"
              transform="rotate(-90 130 130)"></circle>
          </svg>
          <div class="readout">
            <p class="mono phase" id="ttt-phase">work</p>
            <p class="clock mono" id="ttt-time">20:00</p>
            <p class="mono" id="ttt-label">Ready when you are</p>
          </div>
        </div>
        <div class="controls">
          <button type="button" class="btn" id="ttt-start">Start</button>
          <button type="button" class="btn btn-quiet" id="ttt-reset" disabled>Reset</button>
          <label class="chime">
            <input type="checkbox" id="ttt-chime-input" />
            Chime
          </label>
        </div>
        <p class="mono"><span id="ttt-cycles">0</span> breaks completed this session</p>
      </div>

      <ol role="list" class="rule">
        <li><span class="chart">20 min</span> of screen work</li>
        <li><span class="chart">20 ft</span> away, about 6 metres</li>
        <li><span class="chart">20 sec</span> or longer</li>
      </ol>
    </div>
  </Section>

  <Section title="What the research says" subtext="Mixed.">
    <ul role="list" class="evidence">
      {
        evidence.map((item) => (
          <li>
            <h3 class="claim">{item.claim}</h3>
            <p>{item.detail}</p>
            <p class="mono">
              {item.href ? (
                <a class="link" href={item.href} rel="noopener">
                  {item.source}
                </a>
              ) : (
                item.source
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    title="A tab won’t keep the habit. The menu bar can."
    subtext="GazeKeeper counts in the menu bar and defaults to 20 minutes and 20 seconds. It holds the break during calls, screen sharing, and fullscreen."
  >
    <div class="actions">
      <a class="btn" href="/download">Download for Mac</a>
      <a class="btn btn-quiet" href="/eye-strain-risk-calculator">Eye strain risk calculator</a>
    </div>
  </Section>

  <Section title="Questions about the rule">
    <Faq items={faqs} />
  </Section>

  <CtaBand />
</SiteShell>

<script>
  import {
    start,
    pause,
    reset,
    tick,
    formatClock,
    ringProgress,
    loadTimerState,
    saveTimerState,
    WORK_SECONDS,
  } from "../scripts/timer";

  const card = document.getElementById("ttt-timer");
  if (card) {
    const timeEl = document.getElementById("ttt-time")!;
    const labelEl = document.getElementById("ttt-label")!;
    const phaseEl = document.getElementById("ttt-phase")!;
    const startBtn = document.getElementById("ttt-start") as HTMLButtonElement;
    const resetBtn = document.getElementById("ttt-reset") as HTMLButtonElement;
    const chimeInput = document.getElementById("ttt-chime-input") as HTMLInputElement;
    const ringEl = document.getElementById("ttt-ring-progress")!;
    const cyclesEl = document.getElementById("ttt-cycles")!;

    const RING = 2 * Math.PI * 112;
    const defaultTitle = document.title;
    let state = loadTimerState(sessionStorage);
    let raf = 0;

    function everStarted(): boolean {
      return state.cycles > 0 || state.remaining !== WORK_SECONDS || state.phase === "break";
    }

    function render(): void {
      const seconds = state.running
        ? Math.max(1, Math.ceil(((state.endsAt ?? Date.now()) - Date.now()) / 1000))
        : Math.max(0, state.remaining);
      timeEl.textContent = formatClock(seconds);
      phaseEl.textContent = state.phase === "break" ? "look far away" : "work";
      labelEl.textContent = !everStarted()
        ? "Ready when you are"
        : state.running
          ? state.phase === "break"
            ? "Relax your gaze…"
            : "Back to work"
          : "Paused";
      startBtn.textContent = state.running ? "Pause" : "Start";
      resetBtn.disabled = !everStarted();
      cyclesEl.textContent = String(state.cycles);
      const progress = ringProgress(state, Date.now());
      ringEl.style.strokeDashoffset = String(RING * (1 - progress));
      document.title = state.running ? `${formatClock(seconds)} — GazeKeeper` : defaultTitle;
    }

    function loop(): void {
      const result = tick(state, Date.now());
      if (result.completedPhase && state.chime) chime();
      state = result.state;
      saveTimerState(sessionStorage, state);
      render();
      if (state.running) {
        raf = requestAnimationFrame(loop);
      } else {
        cancelAnimationFrame(raf);
      }
    }

    function chime(): void {
      try {
        const ctx = new AudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.frequency.value = 880;
        gain.gain.setValueAtTime(0.06, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.5);
        osc.connect(gain).connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.5);
      } catch {
        /* audio unavailable */
      }
    }

    startBtn.addEventListener("click", () => {
      if (state.running) {
        state = pause(state, Date.now());
        cancelAnimationFrame(raf);
      } else {
        state = start(state, Date.now());
        raf = requestAnimationFrame(loop);
      }
      saveTimerState(sessionStorage, state);
      render();
    });

    resetBtn.addEventListener("click", () => {
      cancelAnimationFrame(raf);
      state = { ...reset(state), remaining: WORK_SECONDS, cycles: 0 };
      saveTimerState(sessionStorage, state);
      render();
    });

    chimeInput.addEventListener("change", () => {
      state.chime = chimeInput.checked;
      saveTimerState(sessionStorage, state);
    });

    render();
  }
</script>

<style>
  .try {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  @media (max-width: 860px) {
    .try {
      grid-template-columns: 1fr;
    }
  }

  .timer {
    display: grid;
    justify-items: center;
    gap: 20px;
  }

  .dial {
    position: relative;
    display: grid;
    place-items: center;
  }

  .dial svg {
    position: absolute;
  }

  .readout {
    display: grid;
    justify-items: center;
    gap: 4px;
    width: 260px;
    height: 260px;
    align-content: center;
  }

  .phase {
    text-transform: uppercase;
  }

  .clock {
    font-size: 56px;
    line-height: 1;
    color: var(--ink);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  .controls .btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .chime {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding-inline: 8px;
    color: var(--ink-2);
    cursor: pointer;
  }

  .chime input {
    width: 20px;
    height: 20px;
    accent-color: var(--teal);
  }

  .rule {
    display: grid;
    border-top: 1.5px solid var(--ink);
  }

  .rule li {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding-block: 20px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .rule .chart {
    min-width: 5ch;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1;
    color: var(--ink);
  }

  .evidence {
    display: grid;
    border-top: 1.5px solid var(--ink);
  }

  .evidence li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 12px clamp(24px, 5vw, 80px);
    padding-block: 28px;
    border-bottom: 1px solid var(--rule);
  }

  @media (max-width: 860px) {
    .evidence li {
      grid-template-columns: 1fr;
    }
  }

  .claim {
    grid-row: span 2;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .evidence p:not(.mono) {
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
  }
</style>
