---
interface Props {
  title: string;
  subtext?: string;
  label?: string;
}

const { title, subtext, label } = Astro.props;
---

<header class="page page-hero">
  {label && <p class="mono">{label}</p>}
  <h1 class="display">{title}</h1>
  {subtext && <p class="lede">{subtext}</p>}
  <slot />
</header>

<style>
  .page-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-block: clamp(64px, 9vw, 128px) clamp(48px, 6vw, 80px);
    border-bottom: 1.5px solid var(--ink);
  }

  .display {
    max-width: 18ch;
  }

  .mono {
    color: var(--teal);
    text-transform: uppercase;
  }
</style>
