---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/base.css";
import { CURRENT_VERSION, MACOS_REQUIREMENT } from "../utils/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "GazeKeeper is a free Mac break reminder. It asks for 20 seconds of distance every 20 minutes, and holds the break while you are on a call, presenting, or typing." } =
  Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/images/og.png", Astro.site);
const site = new URL("/", Astro.site).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": `${site}#software`,
      name: "GazeKeeper",
      description: "A break reminder for the Mac that waits for the right moment.",
      url: site,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: `macOS ${MACOS_REQUIREMENT.replace(/^macOS\s*/i, "")} or later`,
      softwareVersion: CURRENT_VERSION,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      sameAs: ["https://github.com/hridaya423/gazekeeper", "https://www.hridya.tech/projects/gazekeeper"],
      subjectOf: { "@type": "TechArticle", url: "https://www.hridya.tech/projects/gazekeeper" },
      author: {
        "@type": "Person",
        "@id": "https://www.hridya.tech/#person",
        name: "Hridya Agrawal",
        url: "https://www.hridya.tech",
      },
    },
    { "@type": "WebSite", "@id": `${site}#website`, url: site, name: "GazeKeeper" },
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/optician-sans.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content="Hridya Agrawal" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
