---
import { getCollection } from "astro:content";
import SiteShell from "./SiteShell.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { key: "getting-started", label: "Getting started" },
  { key: "deep-dive", label: "Deep dive" },
] as const;
const current = Astro.url.pathname.replace(/\/$/, "");
---

<SiteShell title={title} description={description}>
  <div class="page docs">
    <nav class="docs-nav" aria-label="Documentation">
      {
        groups.map((group) => (
          <div class="group">
            <p class="mono">{group.label}</p>
            <ul role="list">
              {docs
                .filter((doc) => doc.data.section === group.key)
                .map((doc) => (
                  <li>
                    <a
                      href={`/docs/${doc.id}`}
                      aria-current={current === `/docs/${doc.id}` ? "page" : undefined}
                    >
                      {doc.data.title}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <div class="body">
      <slot />
    </div>
  </div>
</SiteShell>

<style>
  .docs {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    padding-block: clamp(40px, 6vw, 88px);
  }

  .docs-nav {
    position: sticky;
    top: 96px;
    align-self: start;
    display: grid;
    gap: 32px;
    padding-right: 24px;
    border-right: 1px solid var(--rule);
  }

  .mono {
    margin-bottom: 8px;
  }

  .docs-nav ul {
    display: grid;
  }

  .docs-nav a {
    display: block;
    padding: 11px 0 11px 14px;
    font-size: 15px;
    color: var(--ink-2);
    transition: color 150ms ease;
  }

  .docs-nav a:hover,
  .docs-nav a[aria-current="page"] {
    color: var(--ink);
  }

  .docs-nav a[aria-current="page"] {
    box-shadow: inset 2px 0 0 var(--teal);
  }

  .body {
    min-width: 0;
  }

  .body :global(.prose code) {
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .docs-nav {
      position: static;
      gap: 16px;
      padding: 0 0 24px;
      border-right: none;
      border-bottom: 1px solid var(--rule);
    }

    .docs-nav ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: 20px;
    }

    .docs-nav a {
      padding-inline: 0;
    }

    .docs-nav a[aria-current="page"] {
      box-shadow: inset 0 -2px 0 var(--teal);
    }
  }
</style>
